{
  "name": "Autonomous Booking via Slack",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.event.channel == \"C0BEQJT05CY\") }",
    "config": {
      "trigger_type": "connector",
      "events": [
        "message"
      ],
      "integration_type": "slack",
      "resource_id": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autonomous_booking_via_slack",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "handleSlackMessage",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "handleSlackMessage"
  }
}