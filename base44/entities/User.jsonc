{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "User role in the app",
      "enum": [
        "admin",
        "driver",
        "staff",
        "client"
      ],
      "default": "user"
    },
    "department": {
      "type": "string",
      "description": "Department or team assignment"
    },
    "client_name": {
      "type": "string",
      "description": "Client name (for client role users)"
    }
  },
  "required": [
    "role"
  ]
}