{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_no": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "docket_nos": {
      "type": "string"
    },
    "line_items_json": {
      "type": "string"
    },
    "subtotal": {
      "type": "number"
    },
    "gst": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue"
      ],
      "default": "draft"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "stripe_payment_url": {
      "type": "string"
    },
    "reminder_count": {
      "type": "number",
      "default": 0
    },
    "client_email": {
      "type": "string"
    }
  },
  "required": [
    "invoice_no",
    "client"
  ]
}